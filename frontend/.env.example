# frontend/.env.example
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git — only .env.example.

# Set to true for local development (mock API, no AWS required)
# Set to false when connecting to a real API Gateway deployment
VITE_USE_MOCK_API=true

# API Gateway HTTP API invoke URL (leave blank when VITE_USE_MOCK_API=true)
# Example (when deployed): https://xxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_API_BASE_URL=
