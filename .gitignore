node_modules/
dist/
build/

# ── Environment secrets — NEVER commit these ───────────────────────────────
.env
.env.local
.env.production
.env.staging
.env.*

# But DO commit .env.example files (they contain only safe placeholder values)
!.env.example
!**/.env.example

# ── AWS credentials — NEVER commit these ───────────────────────────────────
.aws/
credentials

# ── IoT simulator certificates and keys — NEVER commit these ───────────────
simulator/certs/
*.pem
*.crt
*.key
*.p12
*.pfx

# ── Build artifacts ─────────────────────────────────────────────────────────
frontend/dist/
backend/dist/

# ── SAM/CloudFormation build artifacts (not used, included for safety) ──────
.aws-sam/
samconfig.toml

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / editor files ───────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.suo
*.user
*.userosscache
*.sln.docstates

# ── Test coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Package lock files: DO commit these ─────────────────────────────────────
# (package-lock.json, yarn.lock, pnpm-lock.yaml are NOT in this list)
